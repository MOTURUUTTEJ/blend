    font_trail.align_y = 'CENTER'

    text_trail = bpy.data.objects.new(name=f"OCR_Trail_{block_num}", object_data=font_trail)
    text_trail.data.materials.append(mat_stencil_yellow)
    bpy.context.collection.objects.link(text_trail)
    text_trail.parent = parent_block
    text_trail.location = (-0.498, 0.0, 0.0)
    text_trail.rotation_euler = (math.radians(90), 0, math.radians(-90))
    text_trail.scale = (1.0 / 0.58, 1.0 / 0.36, 1.0 / 2.3)

