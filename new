# 10. 3D Bezier Cable Wiring Helper
# -------------------------------------------------------------
def build_network_wire(name, start_pt, end_pt, mat, sag=0.25):
    curve_data = bpy.data.curves.new(name=f"{name}_Data", type='CURVE')
    curve_data.dimensions = '3D'
    curve_data.fill_mode = 'FULL'
    curve_data.bevel_depth = 0.022
    curve_data.bevel_resolution = 3

    polyline = curve_data.splines.new('BEZIER')
    polyline.bezier_points.add(2)

    p0 = polyline.bezier_points[0]
    p1 = polyline.bezier_points[1]
    p2 = polyline.bezier_points[2]

    p0.co = start_pt
    p0.handle_left_type = 'AUTO'
    p0.handle_right_type = 'AUTO'

    mid_pt = (
        (start_pt[0] + end_pt[0]) / 2,
        (start_pt[1] + end_pt[1]) / 2,
        max(start_pt[2], end_pt[2]) + 0.15 - sag
    )
    p1.co = mid_pt
    p1.handle_left_type = 'AUTO'
    p1.handle_right_type = 'AUTO'

    p2.co = end_pt
    p2.handle_left_type = 'AUTO'
    p2.handle_right_type = 'AUTO'

    wire_obj = bpy.data.objects.new(name, curve_data)
    wire_obj.data.materials.append(mat)
    bpy.context.collection.objects.link(wire_obj)
    return wire_obj

