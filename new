def build_conveyor(name, center_x, center_y, center_z, length=9.0, width=1.35):
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, center_z))
    bed = bpy.context.active_object
    bed.name = f"{name}_Bed"
    bed.scale = (length, width, 0.22)
    bed.data.materials.append(mat_machinery_green)
    apply_bevel(bed, 0.02)

    half_w = width / 2
    for y_offset, side in [(-(half_w + 0.045), "L"), ((half_w + 0.045), "R")]:
        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y + y_offset, center_z + 0.18))
        rail = bpy.context.active_object
        rail.name = f"{name}_Rail_{side}"
        rail.scale = (length, 0.07, 0.3)
        rail.data.materials.append(mat_safety_yellow)
        apply_bevel(rail, 0.01)

    steps = int(length // 2.5) + 1
    for k in range(steps):
        px = (center_x - length / 2 + 0.6) + (k * 2.5)
        if px > center_x + length / 2 - 0.4:
            continue
        for y_pos in [-(half_w - 0.02), (half_w - 0.02)]:
            bpy.ops.mesh.primitive_cylinder_add(radius=0.08, depth=center_z, location=(px, center_y + y_pos, center_z / 2))
            leg = bpy.context.active_object
            leg.data.materials.append(mat_cast_steel)

        bpy.ops.mesh.primitive_cylinder_add(radius=0.04, depth=width + 0.02, location=(px, center_y, center_z * 0.4))
        tie = bpy.context.active_object
        tie.rotation_euler = (math.radians(90), 0, 0)
        tie.data.materials.append(mat_cast_steel)

    num_rollers = int(length / 0.65)
    for i in range(num_rollers):
        rx = center_x - length / 2 + 0.3 + (i * 0.65)
        bpy.ops.mesh.primitive_cylinder_add(radius=0.055, depth=width - 0.05, location=(rx, center_y, center_z + 0.11))
        roller = bpy.context.active_object
        roller.name = f"{name}_Roller_{i+1}"
        roller.rotation_euler = (math.radians(90), 0, 0)
        roller.data.materials.append(mat_roller_chrome)

