def align_obj_to_target(obj, target_loc):
    direction = mathutils.Vector(target_loc) - obj.location
    rot_quat = direction.to_track_quat('-Z', 'Y')
    obj.rotation_euler = rot_quat.to_euler()

def build_high_detail_camera_rig(name, pos, target_loc, gantry_beam_loc):
    direction = (mathutils.Vector(target_loc) - mathutils.Vector(pos)).normalized()
    rot_quat = direction.to_track_quat('-Z', 'Y')
    rot_euler = rot_quat.to_euler()

    drop_len = abs(gantry_beam_loc[2] - pos[2])
    stem_center = (pos[0], pos[1], pos[2] + drop_len / 2)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.035, depth=drop_len, location=stem_center)
    arm = bpy.context.active_object
    arm.name = f"{name}_DropStem"
    arm.data.materials.append(mat_gantry_silver)

    bpy.ops.mesh.primitive_cylinder_add(radius=0.08, depth=0.10, location=pos)
    gimbal = bpy.context.active_object
    gimbal.name = f"{name}_Gimbal"
    gimbal.rotation_euler = rot_euler
    gimbal.data.materials.append(mat_cast_steel)

    bpy.ops.mesh.primitive_cube_add(size=1, location=pos)
    cam_box = bpy.context.active_object
    cam_box.name = f"{name}_Enclosure"
    cam_box.scale = (0.24, 0.32, 0.22)
    cam_box.rotation_euler = rot_euler
    cam_box.data.materials.append(mat_vision_blue)
    apply_bevel(cam_box, 0.015)

    lens_loc = mathutils.Vector(pos) + (direction * 0.20)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.08, depth=0.18, location=lens_loc)
    lens_barrel = bpy.context.active_object
    lens_barrel.name = f"{name}_Barrel"
    lens_barrel.rotation_euler = rot_euler
    lens_barrel.data.materials.append(mat_cam_barrel)

    aperture_loc = mathutils.Vector(pos) + (direction * 0.29)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.065, depth=0.02, location=aperture_loc)
    front_element = bpy.context.active_object
    front_element.name = f"{name}_ApertureGlass"
    front_element.rotation_euler = rot_euler
    front_element.data.materials.append(mat_vision_lens)

    ring_loc = mathutils.Vector(pos) + (direction * 0.30)
    bpy.ops.mesh.primitive_torus_add(major_radius=0.11, minor_radius=0.02, location=ring_loc)
    ring_light = bpy.context.active_object
    ring_light.name = f"{name}_RingLight"
    ring_light.rotation_euler = rot_euler
    ring_light.data.materials.append(mat_lens_ring_led)

    back_loc = mathutils.Vector(pos) - (direction * 0.16)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.035, depth=0.08, location=back_loc)
    gland = bpy.context.active_object
    gland.name = f"{name}_Gland"
    gland.rotation_euler = rot_euler
    gland.data.materials.append(mat_cast_steel)

    build_network_wire(f"Wire_{name}_ToServer", back_loc, (SERVER_X, SERVER_Y, SERVER_Z + 1.8), mat_cat6a_cable)

