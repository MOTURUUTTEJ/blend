def align_obj_to_target(obj, target_loc):
    direction = mathutils.Vector(target_loc) - obj.location
    rot_quat = direction.to_track_quat('-Z', 'Y')
    obj.rotation_euler = rot_quat.to_euler()

def build_high_detail_camera_rig(name, pos, target_loc, gantry_beam_loc):
    direction = (mathutils.Vector(target_loc) - mathutils.Vector(pos)).normalized()
    rot_quat = direction.to_track_quat('-Z', 'Y')
    rot_euler = rot_quat.to_euler()

    drop_len = abs(gantry_beam_loc[2] - pos[2])
    stem_center = (pos[0], pos[1], pos[2] + drop_len / 2)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.035, depth=drop_len, location=stem_center)
