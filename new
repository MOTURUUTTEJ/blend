def set_loc_key(obj, frame, loc):
    obj.location = loc
    obj.keyframe_insert(data_path="location", frame=frame)

def set_rot_key(obj, frame, rot):
    obj.rotation_euler = rot
    obj.keyframe_insert(data_path="rotation_euler", frame=frame)

def set_scale_key(obj, frame, scale):
    obj.scale = scale
    obj.keyframe_insert(data_path="scale", frame=frame)

scene.frame_start = 1
scene.frame_end = 560

PAIR_CYCLE_INTERVAL = 140
TRAVEL_F1_BASE      = 35
RIDE_TO_SLOPE_STOP  = 28
STOP_DURATION       = 24
CREST_TIME          = 8
PUSH_STROKE         = 24
HEAT_TIME           = 25
RETRACT_TIME        = 16

NUM_PAIRS = 3

def keyframe_pusher_assembly(ram_obj, rod_list, frame, ram_y):
    set_loc_key(ram_obj, frame, (ram_obj.location.x, ram_y, 4.8))
    for rod, rod_x in rod_list:
        set_loc_key(rod, frame, (rod_x, ram_y - 2.80, 4.8))

for pair_idx in range(NUM_PAIRS):
    t_pair_start = 1 + (pair_idx * PAIR_CYCLE_INTERVAL)
    target_furnace_idx = pair_idx % 2
    furnace_x = furnace_positions[target_furnace_idx]
    fdoor_l, fdoor_r = front_doors_pair_list[target_furnace_idx]
    rdoor_l, rdoor_r = rear_doors_pair_list[target_furnace_idx]
    p = pushers[target_furnace_idx]
    rods_for_station = piston_rods_group[target_furnace_idx]

    pair_blocks = []
    pair_materials = []

    for slot in range(2):
        block_id = (pair_idx * 2) + slot + 1
        esc_x = escalator_x_positions[slot]
        pair_x_offset = 1.25 if slot == 0 else -1.25

        b_mat = make_mat(f"RawCastIron_Mat_{block_id}", (0.16, 0.17, 0.18, 1.0), metallic=0.92, roughness=0.38)
        pair_materials.append(b_mat)

        # Blooms spawn on Ground Floor Infeed Conveyor (Z = 0.8)
        spawn_x = -12.0 - (slot * 2.8)
        bpy.ops.mesh.primitive_cube_add(size=1, location=(spawn_x, 7.5, 0.8))
        block = bpy.context.active_object
        block.name = f"Steel_Product_P{pair_idx+1}_{'A' if slot==0 else 'B'}"
        block.scale = (2.3, 0.58, 0.36)
        block.data.materials.append(b_mat)
        apply_bevel(block, 0.02)
        pair_blocks.append(block)

        add_stamped_id_to_end_faces(block, block_id)

        # Travel on Ground Floor Infeed Conveyor
        set_loc_key(block, t_pair_start, (spawn_x, 7.5, 0.8))
        set_rot_key(block, t_pair_start, (0, 0, 0))

        t_reach_esc = t_pair_start + TRAVEL_F1_BASE + (slot * 8)
        set_loc_key(block, t_reach_esc, (esc_x, 7.5, 0.8))
        set_rot_key(block, t_reach_esc, (0, 0, 0))

        # Ascend Elevator to 1st Floor Level
        t_reach_slope_stop = t_reach_esc + RIDE_TO_SLOPE_STOP
        set_rot_key(block, t_reach_esc + 3, (-ESC_ANGLE, 0, 0))
        set_rot_key(block, t_reach_slope_stop, (-ESC_ANGLE, 0, 0))
        set_loc_key(block, t_reach_slope_stop, (esc_x, 1.2, 4.16))

        # OCR Inspection Pause on Slope
        t_resume_slope = t_reach_slope_stop + STOP_DURATION
        set_loc_key(block, t_resume_slope, (esc_x, 1.2, 4.16))
        set_rot_key(block, t_resume_slope, (-ESC_ANGLE, 0, 0))

        # Crest onto 1st Floor Operating Floor
        t_crest_esc = t_resume_slope + CREST_TIME
        set_rot_key(block, t_crest_esc - 2, (-ESC_ANGLE, 0, 0))
        set_rot_key(block, t_crest_esc, (0, 0, 0))
        set_loc_key(block, t_crest_esc, (esc_x, 0.0, 4.8))

        # Travel unhindered past CP-1 Pulpit along the 1st Floor Staging Line to Target Furnace
        target_staging_x = furnace_x + pair_x_offset
        dist_to_furnace = abs(target_staging_x - esc_x)
        t_reach_furnace = t_crest_esc + int(dist_to_furnace * 2.1)
        set_loc_key(block, t_reach_furnace, (target_staging_x, 0.0, 4.8))
        set_rot_key(block, t_reach_furnace, (0, 0, 0))

    t_pair_staged = max(t_pair_start + 115, t_reach_furnace)
    for slot, block in enumerate(pair_blocks):
        pair_x_offset = 1.25 if slot == 0 else -1.25
        set_loc_key(block, t_pair_staged, (furnace_x + pair_x_offset, 0.0, 4.8))
        set_rot_key(block, t_pair_staged, (0, 0, 0))

    # Pull Pit Staging
    keyframe_pusher_assembly(p, rods_for_station, t_pair_start,  PARKED_RAM_Y)
    keyframe_pusher_assembly(p, rods_for_station, t_pair_staged - 10, PARKED_RAM_Y)
    keyframe_pusher_assembly(p, rods_for_station, t_pair_staged, STAGING_RAM_Y)

    # Front Blast Doors Open
    t_door_open_start = t_pair_staged
    t_door_open_end   = t_door_open_start + 8
    set_loc_key(fdoor_l, t_door_open_start, (furnace_x - 1.35, 1.3, 4.8))
    set_loc_key(fdoor_l, t_door_open_end,   (furnace_x - 1.35, 1.3, 6.2))
    set_loc_key(fdoor_r, t_door_open_start, (furnace_x + 1.35, 1.3, 4.8))
    set_loc_key(fdoor_r, t_door_open_end,   (furnace_x + 1.35, 1.3, 6.2))

    # Pusher Ram Infeed Stroke
    t_approach_start = t_door_open_end + 1
    t_contact        = t_approach_start + 3
    keyframe_pusher_assembly(p, rods_for_station, t_approach_start, STAGING_RAM_Y)
    keyframe_pusher_assembly(p, rods_for_station, t_contact, -0.39)

    t_push_start = t_contact
    t_inside     = t_push_start + PUSH_STROKE

    for slot, block in enumerate(pair_blocks):
        pair_x_offset = 1.25 if slot == 0 else -1.25
        set_loc_key(block, t_push_start, (furnace_x + pair_x_offset, 0.0, 4.8))
        set_loc_key(block, t_inside,     (furnace_x + pair_x_offset, 4.8, 4.8))

    keyframe_pusher_assembly(p, rods_for_station, t_inside, 4.41)

    t_retract_end = t_inside + RETRACT_TIME
    keyframe_pusher_assembly(p, rods_for_station, t_retract_end, PARKED_RAM_Y)

    # Front Doors Close
    t_front_close_start = t_inside + 4
    t_front_close_end   = t_front_close_start + 8
    set_loc_key(fdoor_l, t_front_close_start, (furnace_x - 1.35, 1.3, 6.2))
    set_loc_key(fdoor_l, t_front_close_end,   (furnace_x - 1.35, 1.3, 4.8))
    set_loc_key(fdoor_r, t_front_close_start, (furnace_x + 1.35, 1.3, 6.2))
    set_loc_key(fdoor_r, t_front_close_end,   (furnace_x + 1.35, 1.3, 4.8))

    # Reheating Transformation Inside Furnace Tunnel
    t_heat_done = t_inside + HEAT_TIME
    for slot, block in enumerate(pair_blocks):
        b_mat = pair_materials[slot]
        bsdf = b_mat.node_tree.nodes.get("Principled BSDF")

        bsdf.inputs['Emission Strength'].default_value = 0.0
        bsdf.inputs['Emission Strength'].keyframe_insert(data_path="default_value", frame=t_inside)
        bsdf.inputs['Emission Color'].default_value = (1.0, 0.28, 0.02, 1.0)
        bsdf.inputs['Emission Color'].keyframe_insert(data_path="default_value", frame=t_inside)
        set_scale_key(block, t_inside, (2.3, 0.58, 0.36))

        bsdf.inputs['Emission Strength'].default_value = 30.0
        bsdf.inputs['Emission Strength'].keyframe_insert(data_path="default_value", frame=t_heat_done)
        bsdf.inputs['Base Color'].default_value = (1.0, 0.35, 0.04, 1.0)
        bsdf.inputs['Base Color'].keyframe_insert(data_path="default_value", frame=t_heat_done)

    # Rear Discharge Doors Open & Ingot Exit to Rear Conveyor
    t_rear_open_start = t_heat_done + 2
    t_rear_open_end   = t_rear_open_start + 8
    set_loc_key(rdoor_l, t_rear_open_start, (furnace_x - 1.35, 7.7, 4.8))
    set_loc_key(rdoor_l, t_rear_open_end,   (furnace_x - 1.35, 7.7, 6.2))
    set_loc_key(rdoor_r, t_rear_open_start, (furnace_x + 1.35, 7.7, 4.8))
    set_loc_key(rdoor_r, t_rear_open_end,   (furnace_x + 1.35, 7.7, 6.2))

    t_discharge_start = t_rear_open_end + 2
    t_on_rear_belt    = t_discharge_start + 16

    # Cooling Spray Tunnel Pass & Hot Rolling into Slim Rods
    t_enter_cooling   = t_on_rear_belt + 14
    t_exit_cooling    = t_enter_cooling + 10
    t_enter_rough_mill= t_exit_cooling + 8
    t_finish_slim_rod = t_enter_rough_mill + 20
    t_runout_end      = t_finish_slim_rod + 30

    for slot, block in enumerate(pair_blocks):
        pair_x_offset = 1.25 if slot == 0 else -1.25
        b_mat = pair_materials[slot]
        bsdf = b_mat.node_tree.nodes.get("Principled BSDF")

        # Exit rear furnace throat onto rear conveyor
        set_loc_key(block, t_discharge_start, (furnace_x + pair_x_offset, 4.8, 4.8))
        set_loc_key(block, t_on_rear_belt,    (furnace_x + pair_x_offset, 8.5, 4.8))
        set_scale_key(block, t_on_rear_belt,  (2.3, 0.58, 0.36))

        # Enter High-Pressure Cooling Spray Hood
        set_loc_key(block, t_enter_cooling,   (COOL_TUNNEL_X - 1.2, 8.5, 4.8))
        set_scale_key(block, t_enter_cooling, (2.3, 0.58, 0.36))

        # Exit Cooling Hood
        set_loc_key(block, t_exit_cooling,    (COOL_TUNNEL_X + 1.2, 8.5, 4.8))
        set_scale_key(block, t_exit_cooling,  (2.3, 0.55, 0.34))

        bsdf.inputs['Emission Strength'].default_value = 16.0
        bsdf.inputs['Emission Strength'].keyframe_insert(data_path="default_value", frame=t_exit_cooling)
        bsdf.inputs['Base Color'].default_value = (0.85, 0.22, 0.05, 1.0)
        bsdf.inputs['Base Color'].keyframe_insert(data_path="default_value", frame=t_exit_cooling)

        # Enter Rolling Mill Stands
        set_loc_key(block, t_enter_rough_mill, (mill_stand_positions[0], 8.5, 4.8))
