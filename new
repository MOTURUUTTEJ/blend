    pocket_lead.name = f"Pocket_Lead_{block_num}"
    pocket_lead.scale = (0.015 / 2.3, 0.46 / 0.58, 0.26 / 0.36)
    pocket_lead.location = (0.495, 0.0, 0.0)
    pocket_lead.data.materials.append(mat_engrave_base)
    pocket_lead.parent = parent_block

    font_lead = bpy.data.curves.new(type="FONT", name=f"Text_Lead_{block_num}")
