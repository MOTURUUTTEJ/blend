    text_lead = bpy.data.objects.new(name=f"OCR_Lead_{block_num}", object_data=font_lead)
    text_lead.data.materials.append(mat_stencil_yellow)
    bpy.context.collection.objects.link(text_lead)
    text_lead.parent = parent_block
    text_lead.location = (0.498, 0.0, 0.0)
    text_lead.rotation_euler = (math.radians(90), 0, math.radians(90))
    text_lead.scale = (1.0 / 0.58, 1.0 / 0.36, 1.0 / 2.3)

    # Trail End Face (-X)
    bpy.ops.mesh.primitive_cube_add(size=1)
    pocket_trail = bpy.context.active_object
    pocket_trail.name = f"Pocket_Trail_{block_num}"
    pocket_trail.scale = (0.015 / 2.3, 0.46 / 0.58, 0.26 / 0.36)
    pocket_trail.location = (-0.495, 0.0, 0.0)
    pocket_trail.data.materials.append(mat_engrave_base)
    pocket_trail.parent = parent_block

    font_trail = bpy.data.curves.new(type="FONT", name=f"Text_Trail_{block_num}")
