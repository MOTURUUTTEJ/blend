generated_lot_records = []

def add_stamped_id_to_end_faces(parent_block, block_num):
    random.seed(block_num * 1049)
    lot_lead  = f"LOT-{random.randint(100, 999)}"
    lot_trail = f"ID#{random.randint(100, 999)}"
    generated_lot_records.append((lot_lead, lot_trail))

    # Lead End Face (+X)
    bpy.ops.mesh.primitive_cube_add(size=1)
