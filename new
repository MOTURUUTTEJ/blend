def make_screen_text(name, body, rel_y, rel_z, size, mat):
    font_curve = bpy.data.curves.new(type="FONT", name=f"{name}_Data")
    font_curve.body = body
    font_curve.size = size
    font_curve.align_x = 'LEFT'
    font_curve.align_y = 'CENTER'
    text_obj = bpy.data.objects.new(name=name, object_data=font_curve)
    text_obj.data.materials.append(mat)
    bpy.context.collection.objects.link(text_obj)
    text_obj.parent = lap_screen
    text_obj.location = (-0.46, rel_y, rel_z)
    text_obj.rotation_euler = (math.radians(90), 0, 0)
    text_obj.scale = (1.0 / lap_screen.scale.x, 1.0 / lap_screen.scale.z, 1.0 / lap_screen.scale.y)
    return text_obj

