def create_control_pulpit(name_prefix, sign_text, center_x, center_y, base_z, facing="POS_Y", is_side_oriented=False):
    if is_side_oriented:
        cabin_len_x = 4.0
        cabin_len_y = 5.4
    else:
        cabin_len_x = 5.4
        cabin_len_y = 4.0
    cabin_h = 3.2

    # A. Support Columns
    for col_x in [center_x - cabin_len_x/2 + 0.35, center_x + cabin_len_x/2 - 0.35]:
        for col_y in [center_y - cabin_len_y/2 + 0.35, center_y + cabin_len_y/2 - 0.35]:
            bpy.ops.mesh.primitive_cube_add(size=1, location=(col_x, col_y, (base_z + 4.45) / 2))
            col = bpy.context.active_object
            col.name = f"{name_prefix}_Support_Col"
            col.scale = (0.32, 0.32, base_z - 4.45)
            col.data.materials.append(mat_cast_steel)

    # B. Platform Base & Cantilever Underbody
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, base_z + 0.15))
    floor_obj = bpy.context.active_object
    floor_obj.name = f"{name_prefix}_Floor_Slab"
    floor_obj.scale = (cabin_len_x + 0.6, cabin_len_y + 0.6, 0.3)
    floor_obj.data.materials.append(mat_pulpit_dark)
    apply_bevel(floor_obj, 0.03)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, base_z - 0.45))
    under_wedge = bpy.context.active_object
    under_wedge.name = f"{name_prefix}_Under_Cantilever"
    under_wedge.scale = (cabin_len_x - 0.4, cabin_len_y - 0.4, 0.9)
    under_wedge.data.materials.append(mat_pulpit_dark)

    # C. Lower Armored Hull Wall
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, base_z + 0.85))
    hull = bpy.context.active_object
    hull.name = f"{name_prefix}_Lower_Hull"
    hull.scale = (cabin_len_x, cabin_len_y, 1.1)
    hull.data.materials.append(mat_pulpit_body)
    apply_bevel(hull, 0.04)

    # D. Panoramic Bay Windows & Observation Facade[cite: 1, 2, 3]
    glass_center_z = base_z + 2.1

    if facing == "NEG_X":
        # Facing towards elevators (-X)
        win_x = center_x - (cabin_len_x/2 - 0.25)
        bpy.ops.mesh.primitive_cube_add(size=1, location=(win_x - 0.15, center_y, glass_center_z))
        glass = bpy.context.active_object
        glass.scale = (0.06, cabin_len_y - 0.6, 1.55)
        glass.rotation_euler = (0, math.radians(-8), 0)
        glass.data.materials.append(mat_pulpit_glass)

        # Front Mullions
        for my in [-1.2, 0.0, 1.2]:
            bpy.ops.mesh.primitive_cube_add(size=1, location=(win_x - 0.15, center_y + my, glass_center_z))
            mull = bpy.context.active_object
            mull.scale = (0.14, 0.14, 1.6)
            mull.rotation_euler = (0, math.radians(-8), 0)
            mull.data.materials.append(mat_pulpit_body)

        # Side Windows
        for my_sign in [-1, 1]:
            side_y = center_y + my_sign * (cabin_len_y/2 - 0.15)
            bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + 0.3, side_y, glass_center_z))
            side_g = bpy.context.active_object
            side_g.scale = (cabin_len_x - 1.2, 0.06, 1.55)
            side_g.data.materials.append(mat_pulpit_glass)

        # Rear Solid Wall with Heat Shield
        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + cabin_len_x/2 - 0.1, center_y, glass_center_z))
        rear_wall = bpy.context.active_object
        rear_wall.scale = (0.2, cabin_len_y, 1.6)
        rear_wall.data.materials.append(mat_pulpit_body)

        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + cabin_len_x/2 + 0.12, center_y, glass_center_z))
        heat_shield = bpy.context.active_object
        heat_shield.name = f"{name_prefix}_Furnace_Heat_Shield"
        heat_shield.scale = (0.06, cabin_len_y + 0.4, 2.2)
        heat_shield.data.materials.append(mat_heat_shield)

        sign_pos = (win_x - 0.05, center_y, base_z + 0.85)
        sign_rot = (math.radians(90), 0, math.radians(-90))

        catwalk_loc = (win_x - 0.55, center_y, base_z + 0.15)
        catwalk_scale = (0.9, cabin_len_y + 0.8, 0.12)
        rail_axis = 'Y'

    else:
        # Standard Y-oriented pulpits (CP-2 or CP-3)[cite: 1, 2]
        dir_y = 1 if facing == "POS_Y" else -1
        front_glass_y = center_y + dir_y * (cabin_len_y/2 - 0.25)
        rake_angle = math.radians(-8 * dir_y)

        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, front_glass_y + dir_y * 0.15, glass_center_z))
        glass = bpy.context.active_object
        glass.scale = (cabin_len_x - 0.6, 0.06, 1.55)
        glass.rotation_euler = (rake_angle, 0, 0)
        glass.data.materials.append(mat_pulpit_glass)

        for mull_x in [-1.2, 0.0, 1.2]:
            bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + mull_x, front_glass_y + dir_y * 0.15, glass_center_z))
            mull = bpy.context.active_object
            mull.scale = (0.14, 0.14, 1.6)
            mull.rotation_euler = (rake_angle, 0, 0)
            mull.data.materials.append(mat_pulpit_body)

        for sign_x in [-1, 1]:
            side_x = center_x + sign_x * (cabin_len_x/2 - 0.15)
            bpy.ops.mesh.primitive_cube_add(size=1, location=(side_x, center_y + dir_y * 0.4, glass_center_z))
            side_g = bpy.context.active_object
            side_g.scale = (0.06, cabin_len_y - 1.2, 1.55)
            side_g.data.materials.append(mat_pulpit_glass)

        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y - dir_y * (cabin_len_y/2 - 0.1), glass_center_z))
        rear_wall = bpy.context.active_object
        rear_wall.scale = (cabin_len_x, 0.2, 1.6)
        rear_wall.data.materials.append(mat_pulpit_body)

        sign_pos = (center_x, center_y + dir_y * (cabin_len_y/2 + 0.03), base_z + 0.85)
        sign_rot = (math.radians(90), 0, 0 if dir_y > 0 else math.radians(180))

        catwalk_loc = (center_x, front_glass_y + dir_y * 0.55, base_z + 0.15)
        catwalk_scale = (cabin_len_x + 0.8, 0.9, 0.12)
        rail_axis = 'X'

    # Sign Board Construction[cite: 2]
    bpy.ops.mesh.primitive_cube_add(size=1, location=sign_pos)
    sign_plate = bpy.context.active_object
    sign_plate.scale = (3.4, 0.04, 0.45) if rail_axis == 'X' else (0.04, 3.4, 0.45)
    sign_plate.data.materials.append(mat_pulpit_body)

    font_curve = bpy.data.curves.new(type="FONT", name=f"Font_{name_prefix}")
    font_curve.body = sign_text
    font_curve.size = 0.28
    font_curve.extrude = 0.015
    font_curve.align_x = 'CENTER'
    font_curve.align_y = 'CENTER'
    text_obj = bpy.data.objects.new(f"{name_prefix}_Sign_Text", font_curve)
    text_obj.data.materials.append(mat_stencil_yellow)
    bpy.context.collection.objects.link(text_obj)
    text_obj.location = sign_pos
    text_obj.rotation_euler = sign_rot

    # Roof with Chamfer & Hazard Stripes[cite: 3, 4]
    roof_z = base_z + cabin_h + 0.15
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, roof_z))
    roof = bpy.context.active_object
    roof.name = f"{name_prefix}_Roof_Main"
    roof.scale = (cabin_len_x + 0.5, cabin_len_y + 0.5, 0.55)
    roof.data.materials.append(mat_pulpit_stripes)
    apply_bevel(roof, 0.08)

    # Catwalk Platform & Yellow Handrails[cite: 2, 3]
    bpy.ops.mesh.primitive_cube_add(size=1, location=catwalk_loc)
    cwalk = bpy.context.active_object
    cwalk.scale = catwalk_scale
    cwalk.data.materials.append(mat_cast_steel)

    if rail_axis == 'X':
        dir_y = 1 if facing == "POS_Y" else -1
        for bar_z in [base_z + 0.65, base_z + 1.15]:
            bpy.ops.mesh.primitive_cylinder_add(radius=0.032, depth=cabin_len_x + 0.8, location=(center_x, catwalk_loc[1] + dir_y * 0.42, bar_z))
            top_rail = bpy.context.active_object
            top_rail.rotation_euler = (0, math.radians(90), 0)
            top_rail.data.materials.append(mat_safety_yellow)
    else:
        for bar_z in [base_z + 0.65, base_z + 1.15]:
            bpy.ops.mesh.primitive_cylinder_add(radius=0.032, depth=cabin_len_y + 0.8, location=(catwalk_loc[0] - 0.42, center_y, bar_z))
            top_rail = bpy.context.active_object
            top_rail.rotation_euler = (math.radians(90), 0, 0)
            top_rail.data.materials.append(mat_safety_yellow)

    # Interior Console Desk, Monitors, and Operator Seat
    desk_loc = (center_x - 0.8, center_y, base_z + 1.1) if facing == "NEG_X" else (center_x, center_y + (0.8 if facing == "POS_Y" else -0.8), base_z + 1.1)
    bpy.ops.mesh.primitive_cube_add(size=1, location=desk_loc)
    c_desk = bpy.context.active_object
    c_desk.scale = (0.8, cabin_len_y - 1.2, 0.12) if facing == "NEG_X" else (cabin_len_x - 1.2, 0.8, 0.12)
    c_desk.data.materials.append(mat_desk_top)

    chair_loc = (center_x + 0.2, center_y, base_z + 0.75) if facing == "NEG_X" else (center_x, center_y - (0.2 if facing == "POS_Y" else -0.2), base_z + 0.75)
    bpy.ops.mesh.primitive_cylinder_add(radius=0.35, depth=0.1, location=chair_loc)
    c_seat = bpy.context.active_object
    c_seat.data.materials.append(mat_conveyor_rubber)

    bpy.ops.object.light_add(type='POINT', location=(center_x, center_y, base_z + 2.7))
    p_light = bpy.context.active_object
    p_light.name = f"{name_prefix}_Interior_Glow"
    p_light.data.energy = 500.0
    p_light.data.color = (0.9, 0.95, 1.0)

