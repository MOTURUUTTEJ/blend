def create_control_pulpit(name_prefix, sign_text, center_x, center_y, base_z, facing_dir_y=1):
    cabin_w = 5.4
    cabin_d = 4.0
    cabin_h = 3.2

    # Support Columns from the 1st Floor Slab
    for col_x in [center_x - cabin_w/2 + 0.3, center_x + cabin_w/2 - 0.3]:
        for col_y in [center_y - cabin_d/2 + 0.3, center_y + cabin_d/2 - 0.3]:
            bpy.ops.mesh.primitive_cube_add(size=1, location=(col_x, col_y, (base_z + 4.45) / 2))
            col = bpy.context.active_object
            col.name = f"{name_prefix}_Support_Column"
            col.scale = (0.32, 0.32, base_z - 4.45)
            col.data.materials.append(mat_cast_steel)

    # Base Platform Floor & Cantilever Wedge
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, base_z + 0.15))
    floor_obj = bpy.context.active_object
    floor_obj.name = f"{name_prefix}_Floor_Slab"
    floor_obj.scale = (cabin_w + 0.6, cabin_d + 0.8, 0.3)
    floor_obj.data.materials.append(mat_pulpit_dark)
    apply_bevel(floor_obj, 0.03)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y + facing_dir_y * (cabin_d/4), base_z - 0.45))
    under_wedge = bpy.context.active_object
    under_wedge.name = f"{name_prefix}_Under_Cantilever"
    under_wedge.scale = (cabin_w - 0.4, cabin_d / 2, 0.9)
    under_wedge.data.materials.append(mat_pulpit_dark)

    # Lower Hull & Sign Plate
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y, base_z + 0.85))
    hull = bpy.context.active_object
    hull.name = f"{name_prefix}_Lower_Hull"
    hull.scale = (cabin_w, cabin_d, 1.1)
    hull.data.materials.append(mat_pulpit_body)
    apply_bevel(hull, 0.04)

    sign_face_y = center_y + facing_dir_y * (cabin_d/2 + 0.02)
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, sign_face_y, base_z + 0.85))
    sign_plate = bpy.context.active_object
    sign_plate.scale = (3.4, 0.04, 0.45)
    sign_plate.data.materials.append(mat_pulpit_body)

    font_curve = bpy.data.curves.new(type="FONT", name=f"Font_{name_prefix}")
    font_curve.body = sign_text
    font_curve.size = 0.28
    font_curve.extrude = 0.015
    font_curve.align_x = 'CENTER'
    font_curve.align_y = 'CENTER'
    text_obj = bpy.data.objects.new(f"{name_prefix}_Sign_Text", font_curve)
    text_obj.data.materials.append(mat_stencil_yellow)
    bpy.context.collection.objects.link(text_obj)
    text_obj.location = (center_x, sign_face_y + facing_dir_y * 0.03, base_z + 0.85)
    text_obj.rotation_euler = (math.radians(90), 0, 0 if facing_dir_y > 0 else math.radians(180))

    # Forward Rake Windows & Mullions
    glass_center_z = base_z + 2.1
    front_glass_y = center_y + facing_dir_y * (cabin_d/2 - 0.25)
    rake_angle = math.radians(-8 * facing_dir_y)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, front_glass_y + facing_dir_y * 0.15, glass_center_z))
    glass = bpy.context.active_object
    glass.name = f"{name_prefix}_Panoramic_Glass"
    glass.scale = (cabin_w - 0.6, 0.06, 1.55)
    glass.rotation_euler = (rake_angle, 0, 0)
    glass.data.materials.append(mat_pulpit_glass)

    for mull_x in [-1.2, 0.0, 1.2]:
        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + mull_x, front_glass_y + facing_dir_y * 0.15, glass_center_z))
        mull = bpy.context.active_object
        mull.name = f"{name_prefix}_Mullion_{mull_x}"
        mull.scale = (0.14, 0.14, 1.6)
        mull.rotation_euler = (rake_angle, 0, 0)
        mull.data.materials.append(mat_pulpit_body)

    for sign_x in [-1, 1]:
        side_x = center_x + sign_x * (cabin_w/2 - 0.15)
        bpy.ops.mesh.primitive_cube_add(size=1, location=(side_x, center_y + facing_dir_y * 0.4, glass_center_z))
        side_glass = bpy.context.active_object
        side_glass.scale = (0.06, cabin_d - 1.2, 1.55)
        side_glass.data.materials.append(mat_pulpit_glass)

        bpy.ops.mesh.primitive_cube_add(size=1, location=(side_x, front_glass_y, glass_center_z))
        c_pillar = bpy.context.active_object
        c_pillar.scale = (0.22, 0.22, 1.6)
        c_pillar.data.materials.append(mat_pulpit_body)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y - facing_dir_y * (cabin_d/2 - 0.1), glass_center_z))
    rear_wall = bpy.context.active_object
    rear_wall.scale = (cabin_w, 0.2, 1.6)
    rear_wall.data.materials.append(mat_pulpit_body)

    # Chamfered Roof with Hazard Stripes
    roof_z = base_z + cabin_h + 0.15
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y + facing_dir_y * 0.1, roof_z))
    roof = bpy.context.active_object
    roof.name = f"{name_prefix}_Roof_Main"
    roof.scale = (cabin_w + 0.5, cabin_d + 0.8, 0.55)
    roof.data.materials.append(mat_pulpit_stripes)
    apply_bevel(roof, 0.08)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, center_y + facing_dir_y * (cabin_d/2 + 0.25), roof_z - 0.15))
    roof_brow = bpy.context.active_object
    roof_brow.name = f"{name_prefix}_Roof_Chamfer_Brow"
    roof_brow.scale = (cabin_w + 0.4, 0.4, 0.45)
    roof_brow.rotation_euler = (math.radians(-30 * facing_dir_y), 0, 0)
    roof_brow.data.materials.append(mat_pulpit_stripes)

    # Catwalk Railings & Stairs on 1st Floor
    catwalk_y = front_glass_y + facing_dir_y * 0.55
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, catwalk_y, base_z + 0.15))
    cwalk = bpy.context.active_object
    cwalk.scale = (cabin_w + 0.8, 0.9, 0.12)
    cwalk.data.materials.append(mat_cast_steel)

    for bar_z in [base_z + 0.65, base_z + 1.15]:
        bpy.ops.mesh.primitive_cylinder_add(radius=0.032, depth=cabin_w + 0.8, location=(center_x, catwalk_y + facing_dir_y * 0.42, bar_z))
        top_rail = bpy.context.active_object
        top_rail.rotation_euler = (0, math.radians(90), 0)
        top_rail.data.materials.append(mat_safety_yellow)

    for rx in [-cabin_w/2 - 0.3, -cabin_w/4, 0.0, cabin_w/4, cabin_w/2 + 0.3]:
        bpy.ops.mesh.primitive_cylinder_add(radius=0.035, depth=1.05, location=(center_x + rx, catwalk_y + facing_dir_y * 0.42, base_z + 0.65))
        rail_post = bpy.context.active_object
        rail_post.data.materials.append(mat_safety_yellow)

    stair_start_x = center_x + cabin_w/2 + 0.8
    for st in range(6):
        st_frac = st / 6
        st_x = stair_start_x + (st_frac * 1.5)
        st_z = base_z - (st_frac * 0.75) + 0.1
        bpy.ops.mesh.primitive_cube_add(size=1, location=(st_x, center_y, st_z))
        step = bpy.context.active_object
        step.scale = (0.35, 1.0, 0.06)
        step.data.materials.append(mat_cast_steel)

    # Interior Console Desk & Controls
    desk_y = front_glass_y - facing_dir_y * 0.45
    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, desk_y, base_z + 1.1))
    c_desk = bpy.context.active_object
    c_desk.scale = (cabin_w - 1.0, 0.9, 0.12)
    c_desk.data.materials.append(mat_desk_top)

    for mon_x, angle_yaw in [(-1.5, 18), (-0.5, 6), (0.5, -6), (1.5, -18)]:
        bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x + mon_x, front_glass_y - facing_dir_y * 0.35, base_z + 1.45))
        mon = bpy.context.active_object
        mon.scale = (0.85, 0.04, 0.48)
        mon.rotation_euler = (math.radians(-10 * facing_dir_y), 0, math.radians(angle_yaw * facing_dir_y))
        mon.data.materials.append(mat_server_screen)

    chair_y = center_y - facing_dir_y * 0.4
    bpy.ops.mesh.primitive_cylinder_add(radius=0.35, depth=0.1, location=(center_x, chair_y, base_z + 0.75))
    c_seat = bpy.context.active_object
    c_seat.data.materials.append(mat_conveyor_rubber)

    bpy.ops.mesh.primitive_cube_add(size=1, location=(center_x, chair_y - facing_dir_y * 0.3, base_z + 1.15))
    c_back = bpy.context.active_object
    c_back.scale = (0.55, 0.1, 0.65)
    c_back.data.materials.append(mat_conveyor_rubber)

    bpy.ops.object.light_add(type='POINT', location=(center_x, center_y, base_z + 2.7))
    p_light = bpy.context.active_object
    p_light.name = f"{name_prefix}_Interior_Glow"
    p_light.data.energy = 500.0
    p_light.data.color = (0.9, 0.95, 1.0)

