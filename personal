    build_high_detail_camera_rig(f"Rig_Furnace{furnace_num}_Trail", pos_fcam_trail, f_face_trail_end_loc, (fx - 3.65, 0.0, 7.0))

    for pos_spot, target in [(pos_fcam_lead, f_face_lead_end_loc), (pos_fcam_trail, f_face_trail_end_loc)]:
